rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién es quién ----------
    function signed() { return request.auth != null; }
    function esDueno() {
      return signed() && request.auth.token.email == 'gabohuppi22@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function rutaPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function tienePerfil() { return esDueno() || (signed() && exists(rutaPerfil())); }
    function perfil() { return get(rutaPerfil()).data; }
    function esProfe() { return signed() && exists(rutaPerfil()) && perfil().rol == 'profe'; }
    function esStaff() { return esDueno() || esProfe(); }
    function esAlumno() { return signed() && exists(rutaPerfil()) && perfil().rol == 'alumno'; }
    function miAlumno() { return perfil().alumnoId; }
    // Una cuenta puede manejar a más de un alumno (por ejemplo una mamá con su hijo): 'alumnos' en usuarios/{uid}.
    function misAlumnos() { return perfil().get('alumnos', []).concat([perfil().alumnoId]); }
    function esMio(id) { return esAlumno() && id in misAlumnos(); }
    function doc(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    // ---------- Usuarios (accesos) ----------
    match /usuarios/{uid} {
      allow read: if esStaff() || (signed() && request.auth.uid == uid);
      allow write: if esDueno();
    }

    // ---------- Alumnos ----------
    // El alumno solo ve su ficha. Solo puede cambiar "recuperar" de a 1,
    // y únicamente junto con el aviso que lo justifica.
    function cambioPorAviso(id) {
      let d = request.resource.data;
      let o = resource.data;
      let av = getAfter(doc('avisos', d.ultimoAviso)).data;
      return d.diff(o).affectedKeys().hasOnly(['recuperar', 'ultimoAviso'])
        && !exists(doc('avisos', d.ultimoAviso))
        && av.alumnoId == id
        && ((av.tipo == 'ausencia' && av.conRecupero == true && d.recuperar == o.get('recuperar', 0) + 1)
          || (av.tipo == 'recupera' && o.get('recuperar', 0) >= 1 && d.recuperar == o.get('recuperar', 0) - 1));
    }
    match /alumnos/{id} {
      allow read: if esStaff() || esMio(id);
      allow create, delete: if esDueno();
      allow update: if esStaff() || (esMio(id) && cambioPorAviso(id));
    }

    // ---------- Avisos: "no voy" y reservas para recuperar ----------
    function lugaresOk(d) {
      let c = getAfter(doc('cupos', d.club + '_' + d.fecha + '_' + d.hhmm)).data;
      let base = get(doc('publico', 'turnos')).data.t.get(d.club + '|' + string(d.dia) + '|' + d.hora, {'n': 99}).n;
      return base - c.aus + c.rec <= 4;
    }
    function avisoValido(id) {
      let d = request.resource.data;
      return esMio(d.alumnoId) && d.uid == request.auth.uid
        && d.tipo in ['ausencia', 'recupera']
        && id == d.alumnoId + '_' + d.fecha + '_' + d.hhmm + '_' + d.tipo
        && d.inicio is timestamp && d.inicio > request.time
        && d.visto == false
        && (d.tipo != 'ausencia' || d.conRecupero == false || d.inicio > request.time + duration.value(24, 'h'))
        && ((d.tipo == 'ausencia' && d.conRecupero == false)
          || getAfter(doc('alumnos', d.alumnoId)).data.ultimoAviso == id)
        && getAfter(doc('cupos', d.club + '_' + d.fecha + '_' + d.hhmm)).data.ultimo == id
        && (d.tipo == 'ausencia' || lugaresOk(d));
    }
    // ---------- Pedidos de alumnos para sumar un día ----------
    match /solicitudes/{id} {
      allow read: if esStaff() || esMio(resource.data.alumnoId);
      allow create: if esAlumno() && esMio(request.resource.data.alumnoId)
        && request.resource.data.estado == 'pendiente' && request.resource.data.notificado == false
        && request.resource.data.keys().hasOnly(['alumnoId','nombre','club','dia','hora','nivel','estado','notificado','creado']);
      allow update: if esStaff();
      allow delete: if esStaff() || esMio(resource.data.alumnoId);
    }
    match /avisos/{id} {
      allow read: if esStaff() || esMio(resource.data.alumnoId);
      allow create: if esStaff() || (esAlumno() && avisoValido(id));
      allow update, delete: if esStaff();
    }

    // ---------- Lugares por clase y fecha ----------
    function cupoPorAviso() {
      let d = request.resource.data;
      let o = resource == null ? {'aus': 0, 'rec': 0} : resource.data;
      let av = getAfter(doc('avisos', d.ultimo)).data;
      return !exists(doc('avisos', d.ultimo)) && esMio(av.alumnoId)
        && ((av.tipo == 'ausencia' && d.aus == o.get('aus', 0) + 1 && d.rec == o.get('rec', 0))
          || (av.tipo == 'recupera' && d.rec == o.get('rec', 0) + 1 && d.aus == o.get('aus', 0)));
    }
    match /cupos/{id} {
      allow read: if tienePerfil();
      allow create, update: if esStaff() || (esAlumno() && cupoPorAviso());
      allow delete: if esStaff();
    }

    // ---------- Reemplazos: el alumno manda a otra persona a usar su recuperación ----------
    // Uno por clase (id = alumnoId_fecha_hhmm), solo antes de que empiece. Lo puede cancelar hasta que empiece.
    function reemplazoOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['alumnoId', 'uid', 'nombre', 'quien', 'fecha', 'hora', 'hhmm', 'club', 'inicio', 'creado', 'notificado'])
        && esMio(d.alumnoId) && d.uid == request.auth.uid
        && id == d.alumnoId + '_' + d.fecha + '_' + d.hhmm
        && d.quien is string && d.quien.size() >= 2 && d.quien.size() <= 40
        && d.inicio is timestamp && d.inicio > request.time
        && d.creado == request.time && d.notificado == false;
    }
    match /reemplazos/{id} {
      allow read: if esStaff() || esMio(resource.data.alumnoId);
      allow create: if esStaff() || (esAlumno() && reemplazoOk(id));
      allow update: if esStaff();
      allow delete: if esStaff() || (esMio(resource.data.alumnoId) && resource.data.inicio > request.time);
    }

    // ---------- Pagos: el alumno sube el comprobante y el mes queda pagado ----------
    // Uno por alumno y mes (id = alumnoId_AAAA-MM). Solo se puede volver a mandar si Gabriel lo rechazó.
    function compPrevioOk(id) {
      return !exists(doc('comprobantes', id)) || get(doc('comprobantes', id)).data.estado == 'rechazado';
    }
    function comprobanteOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['alumnoId', 'uid', 'nombre', 'mes', 'monto', 'estado', 'aplicado', 'notificado', 'creado'])
        && esMio(d.alumnoId) && d.uid == request.auth.uid
        && d.mes is string && d.mes.matches('^20[0-9][0-9]-(0[1-9]|1[0-2])$')
        && id == d.alumnoId + '_' + d.mes
        && d.monto is number && d.monto > 0 && d.estado == 'enviado' && d.aplicado == false && d.notificado == false
        && d.creado == request.time
        && compPrevioOk(id)
        && existsAfter(doc('fotosPago', id));
    }
    match /comprobantes/{id} {
      allow read: if esDueno() || esMio(resource.data.alumnoId);
      allow create, update: if esStaff() || (esAlumno() && comprobanteOk(id));
      allow delete: if esStaff();
    }
    match /fotosPago/{id} {
      allow read: if esDueno() || esMio(resource.data.alumnoId);
      allow create, update: if esStaff() || (esAlumno()
        && request.resource.data.keys().hasOnly(['alumnoId', 'mes', 'foto'])
        && esMio(request.resource.data.alumnoId)
        && id == request.resource.data.alumnoId + '_' + request.resource.data.mes
        && request.resource.data.foto is string && request.resource.data.foto.size() < 750000
        && compPrevioOk(id)
        && getAfter(doc('comprobantes', id)).data.alumnoId == request.resource.data.alumnoId);
      allow delete: if esStaff();
    }

    // ---------- Resto ----------
    match /asistencia/{id} {
      allow read: if tienePerfil();
      allow write: if esStaff();
    }
    match /publico/{id} {
      allow read: if tienePerfil();
      // El profe solo publica la grilla de turnos y las suspensiones; el alias y los datos de cobro, solo Gabriel.
      allow write: if esDueno() || (esProfe() && id in ['turnos', 'suspendidas']);
    }
    // Pruebas e invitados que Gabriel suma a un turno (ocupan lugar).
    // Primer ingreso de cada alumno a la app (y si activó las notificaciones).
    match /ingresos/{uid} {
      allow read: if esStaff() || (esAlumno() && request.auth.uid == uid);
      allow create: if esAlumno() && request.auth.uid == uid && esMio(request.resource.data.alumnoId)
        && request.resource.data.notificado == false
        && request.resource.data.keys().hasOnly(['alumnoId', 'nombre', 'primera', 'ultimo', 'notif', 'notificado']);
      allow update: if esAlumno() && request.auth.uid == uid && esMio(request.resource.data.alumnoId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo', 'notif', 'nombre']);
    }
    match /staffAvisos/{id} {
      allow create: if esStaff();
      allow read, update, delete: if esDueno();
    }
    match /lluvias/{id} {
      allow read, write: if esStaff();
    }
    // Días sin clases (Gabriel o Esteban suspenden): el proceso automático les avisa a los alumnos.
    match /suspensiones/{id} {
      allow read, write: if esStaff();
    }
    match /extras/{id} {
      allow read, write: if esStaff();
    }
    // Gestión de Gabriel (cancha de Gonza): solo él.
    match /gestion/{id} {
      allow read, write: if esDueno();
    }
    match /config/{id} {
      allow read: if esStaff();
      allow write: if esDueno();
    }
    match /interesados/{id} {
      allow read, write: if esDueno();
    }
    match /horas/{uid} {
      allow read, write: if esDueno() || (esProfe() && request.auth.uid == uid);
    }
    // Notificaciones: cada uno guarda sus propios códigos de aviso. Los recordatorios los maneja el proceso automático.
    // Cada uno se anota solo con su propio rol (un alumno no puede anotarse como Gabriel ni como otro alumno).
    function tokenOk() {
      let d = request.resource.data;
      return esDueno() ? d.get('rol', 'dueño') == 'dueño'
        : (d.get('rol', '') == perfil().rol && (perfil().rol != 'alumno' || d.get('alumnoId', '') == miAlumno()));
    }
    // Avisos de otro alumno que maneja la misma cuenta (tokens/{uid}__{alumnoId}).
    function tokenExtraOk(tid) {
      let d = request.resource.data;
      return esAlumno() && d.get('rol', '') == 'alumno' && esMio(d.get('alumnoId', '')) && tid == request.auth.uid + '__' + d.alumnoId;
    }
    match /tokens/{uid} {
      allow read: if tienePerfil() && (request.auth.uid == uid || uid.matches(request.auth.uid + '__.*'));
      allow create, update: if tienePerfil() && ((request.auth.uid == uid && tokenOk()) || tokenExtraOk(uid));
      allow delete: if tienePerfil() && (request.auth.uid == uid || uid.matches(request.auth.uid + '__.*'));
    }
    match /recordatorios/{id} {
      allow read, write: if false;
    }
    match /finanzas/{uid} {
      allow read, write: if esDueno() || (esProfe() && request.auth.uid == uid);
    }
    // Mi Agenda (personal de Gabriel): tareas, pendientes, agenda y gastos. Solo él.
    match /agenda/{uid} {
      allow read, write: if esDueno() && request.auth.uid == uid;
      match /items/{id} {
        allow read, write: if esDueno() && request.auth.uid == uid;
      }
    }
  }
}
